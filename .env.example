# Backend Server Port
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# YouTube Data API v3 Key (Server-Side Only)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Cloud BigQuery
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=learntrace
BIGQUERY_LOCATION=US

# Gemini (server-side only)
# Leave this as gemini-api until the Vertex setup below is complete.
GEMINI_PROVIDER=gemini-api
GEMINI_API_KEY=
## Vertex AI alternative (uses ADC/service-account credentials, not GEMINI_API_KEY)
# GEMINI_PROVIDER=vertex-ai
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DIAGNOSIS_MODEL=
GEMINI_MAX_REQUESTS_PER_MINUTE=2
GEMINI_MAX_REQUESTS_PER_DAY=10
GEMINI_BATCH_SIZE=50
GEMINI_MAX_COMMENTS_PER_ANALYSIS=50
GEMINI_MAX_CONCURRENT_REQUESTS=1
GEMINI_TARGET_ANALYZED_CONVERSATIONS=200
